<!-- IRadio slot1 with a synthetic SIM, hosted by /system/bin/aemu-radio: a GSI ships no radio HAL,
     so without this the telephony framework reports SIM absent on a guest whose modem is the host's RilStub -->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.radio</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <version>1.1</version>
        <version>1.2</version>
        <version>1.3</version>
        <version>1.4</version>
        <interface>
            <name>IRadio</name>
            <instance>slot1</instance>
        </interface>
    </hal>
</manifest>
