    <string name="vm_boot_seat_title">開機座位：分割區＋ramdisk 自己的 init</string>
    <string name="vm_boot_seat_sub">各分割區以裝置形式呈現（by-name 節點、真掛載表），且開機時先執行 boot 映像 ramdisk 裡的 /init 作第一個行程——由它佈置並交棒，跟真機一樣——取代宿主的服務計劃。限以本版匯入的客體（有保留 boot 映像者）。實驗功能，下次完整開機生效。</string>
    <string name="kmroot_title">客體 keymaster 根證書</string>
    <string name="kmroot_sub">這台客體的軟體 keymaster 用編在系統函式庫裡的一條鏈簽 attestation。在這裡換成你自己的：證書內容全部自己填（不預填任何東西），產生或導入一條鏈，再植入這台客體的函式庫。植入前會先備份原版函式庫，隨時可還原。改動在客體下次開機生效。</string>
    <string name="kmroot_fields">根證書內容</string>
    <string name="kmroot_fields_sub">留空的欄位就不寫進證書。簽署用證書沿用同一個名字，兩者靠序號與用途區分，不靠文字。</string>
    <string name="kmroot_years">效期（年）</string>
    <string name="kmroot_years_sub">填 1 到 50 的整數。</string>
    <string name="kmroot_generate">產生</string>
    <string name="kmroot_need_subject">先至少填一項證書欄位。</string>
    <string name="kmroot_need_years">效期請填 1 到 50 年。</string>
    <string name="kmroot_status_none">尚無鏈材料——在上面產生一組，或導入一個包。</string>
    <string name="kmroot_subject">根的名字：%1$s</string>
    <string name="kmroot_fp_rsa">RSA 根 SHA-256：%1$s</string>
    <string name="kmroot_fp_ec">EC 根 SHA-256：%1$s</string>
    <string name="kmroot_source_generated">在此產生</string>
    <string name="kmroot_source_imported">導入</string>
    <string name="kmroot_meta_line">%1$s · %2$s</string>
    <string name="kmroot_state_pristine">函式庫：仍是內建鏈。</string>
    <string name="kmroot_state_implanted_this">函式庫：已植入這條鏈。</string>
    <string name="kmroot_state_implanted_other">函式庫：已植入，但不是目前手上這條鏈。</string>
    <string name="kmroot_state_changed">函式庫：與備份和目前的鏈都不同。</string>
    <string name="kmroot_import">導入</string>
    <string name="kmroot_import_sub">一個 PEM 包或 PKCS#12，內含 RSA 與 EC 兩組各自的：根證書、根私鑰、簽署證書、簽署私鑰。導入時逐件驗證；之後用包裡自己的鑰與名字、按函式庫的固定長度重簽證書——因為成品證書沒法在不弄斷簽名的情況下改長度。</string>
    <string name="kmroot_password">包的密碼（有加密才填）</string>
    <string name="kmroot_export">匯出</string>
    <string name="kmroot_export_warn">匯出的包含私鑰，請妥善保管。</string>
    <string name="kmroot_implant">植入</string>
    <string name="kmroot_implant_confirm_title">植入這條鏈？</string>
    <string name="kmroot_implant_confirm">這台客體 keymaster 函式庫的六個內建位置會被改寫成這條鏈，改寫前先備份原版。客體下次開機生效。</string>
    <string name="kmroot_restore">還原原版</string>
    <string name="kmroot_restore_confirm_title">還原原版函式庫？</string>
    <string name="kmroot_restore_confirm">備份的原版函式庫會逐字節放回，內建鏈在客體下次開機重新生效。</string>
