    <string name="vs_bluetooth">Bluetooth</string>
    <string name="vs_bluetooth_sub">The guest uses the phone\'s own Bluetooth: scan, pairing, RFCOMM and BLE GATT through the host adapter. Android 4.4 guests; the phone\'s Bluetooth must be on and the guest can only follow it. Applies at the next boot.</string>
