<?xml version="1.0" encoding="utf-8"?>
<!-- The guest agent's app: the Root Manager (the launcher entry — status, the hide list, the self
     test, all asked of the agent service) and the import inbox (what the host streamed into the
     guest's AEmuImport folder, handed to the guest's own package installer). Installed by the host at
     boot complete (AgentSupport.APK_COPY); the package id is AgentSupport.APP_PACKAGE. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.aemu.agent"
    android:versionCode="8"
    android:versionName="1.7">

    <uses-sdk android:minSdkVersion="14" android:targetSdkVersion="23" />

    <application
        android:label="AEmu Import"
        android:theme="@android:style/Theme.Holo">
        <activity
            android:name=".ManagerActivity"
            android:label="AEmu Root Manager"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".InboxActivity"
            android:exported="true" />
        <activity
            android:name=".VpnTestActivity"
            android:label="VPN 測試（M2）"
            android:exported="true" />
        <activity
            android:name=".IsoProbeActivity"
            android:label="隔離探針"
            android:exported="true" />
        <service
            android:name=".VpnTestService"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
